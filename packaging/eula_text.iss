procedure LoadEmbeddedEula(Memo: TNewMemo);
begin
  if ActiveLanguage = 'arabic' then
    LoadEula_ar(Memo)
  else if ActiveLanguage = 'italian' then
    LoadEula_it(Memo)
  else if ActiveLanguage = 'spanish' then
    LoadEula_es(Memo)
  else if ActiveLanguage = 'portuguese' then
    LoadEula_pt(Memo)
  else if ActiveLanguage = 'turkish' then
    LoadEula_tr(Memo)
  else
    LoadEula_en(Memo);
end;
