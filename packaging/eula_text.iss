  Memo.Lines.Add('All intellectual-property rights relating to this software, including its');
  Memo.Lines.Add('source code, design and marks, belong to its developer, Mohamed Mosad. The');
  Memo.Lines.Add('software may not be copied, redistributed, modified, sold, re-licensed or');
  Memo.Lines.Add('reverse-engineered, in whole or in part, without the developer''s prior written');
  Memo.Lines.Add('permission.');
  Memo.Lines.Add('');
  Memo.Lines.Add('3. Limitation of liability');
  Memo.Lines.Add('This software is provided "AS IS", without any express or implied warranty. The');
  Memo.Lines.Add('developer is not liable for any direct or indirect damage, data loss or');
  Memo.Lines.Add('corruption arising from the use of this software.');
  Memo.Lines.Add('');
  Memo.Lines.Add('4. Technical support and suggestions');
  Memo.Lines.Add('For suggestions and technical support you can contact the developer on WhatsApp');
  Memo.Lines.Add('or Telegram at : +20 10 40 24 30 45');
  Memo.Lines.Add('');
  Memo.Lines.Add('5. Governing law');
  Memo.Lines.Add('This agreement is governed by the laws applicable in the developer''s country,');
  Memo.Lines.Add('without prejudice to any mandatory rights granted to you by your local consumer');
  Memo.Lines.Add('protection laws.');
  Memo.Lines.Add('');
  Memo.Lines.Add('====================================================================');
  Memo.Lines.Add('');
  Memo.Lines.Add('By selecting "I accept the agreement" you confirm that you have read and');
  Memo.Lines.Add('understood these terms and agree to be bound by them. If you do not agree,');
  Memo.Lines.Add('please close the installer and the installation will be cancelled.');
